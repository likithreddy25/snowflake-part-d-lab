# Snowflake Configuration
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control (it's in .gitignore)

# Snowflake Account Identifier (from welcome email, format: xy12345.us-east-1)
SNOWFLAKE_ACCOUNT=your_account_identifier

# Snowflake User (the user you created for dbt/analytics)
SNOWFLAKE_USER=your_username

# Snowflake Role (should be PARTD_ENGINEER for pipeline work)
SNOWFLAKE_ROLE=PARTD_ENGINEER

# Snowflake Warehouse (should be WH_PARTD)
SNOWFLAKE_WAREHOUSE=WH_PARTD

# Snowflake Database (should be PARTD_LAB)
SNOWFLAKE_DATABASE=PARTD_LAB

# Authentication: Choose ONE of the following

# Option A: Key Pair Authentication (Recommended)
# Path to private key file (generate with scripts/generate_keypair.sh)
SNOWFLAKE_PRIVATE_KEY_PATH=keys/your_username_private_key.p8

# Passphrase for the encrypted private key
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_passphrase

# Option B: Password Authentication (Less secure, not recommended)
# SNOWFLAKE_PASSWORD=your_password

# Optional: Data Download Configuration
CMS_DATA_LIMIT=500000  # Max rows to download (default: 500k)
CMS_DATA_OUTPUT_DIR=data/raw  # Output directory for CSV files
